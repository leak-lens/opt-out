{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Data protection law entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "law",
    "jurisdictions",
    "letterLangs",
    "deadline",
    "authorities",
    "types",
    "sources",
    "status",
    "checkedOn"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case, equals file name without .json"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "description": "Short display name, e.g. \"GDPR (EU / EEA)\""
    },
    "law": {
      "type": "string",
      "minLength": 5,
      "description": "Official title of the law in English, with number/date if applicable"
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}(-[A-Z0-9]{2,3})?$"
      },
      "description": "ISO 3166-1 alpha-2 codes, or ISO 3166-2 for sub-national (US-CA)"
    },
    "letterLangs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "en",
          "ru",
          "az",
          "tr",
          "uk",
          "kk",
          "uz",
          "ka",
          "hy",
          "be",
          "de",
          "fr",
          "es",
          "pt",
          "ja",
          "ko"
        ]
      },
      "description": "Languages in which letter text is provided. \"en\" is mandatory; a local language may be added."
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "days",
        "text"
      ],
      "properties": {
        "days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Calendar days to respond; null if the law gives no fixed number or you could not verify it"
        },
        "text": {
          "type": "string",
          "minLength": 3,
          "description": "Human-readable response deadline, in English"
        },
        "citation": {
          "type": "string",
          "description": "Where the deadline comes from, e.g. 'Art. 12(3)'"
        }
      }
    },
    "authorities": {
      "type": "object",
      "minProperties": 1,
      "description": "Key = jurisdiction code from `jurisdictions`. The body to complain to.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "description": "Only request types the law really supports. Omit unsupported ones.",
      "properties": {
        "access": {
          "$ref": "#/definitions/requestType"
        },
        "erasure": {
          "$ref": "#/definitions/requestType"
        },
        "rectification": {
          "$ref": "#/definitions/requestType"
        },
        "portability": {
          "$ref": "#/definitions/requestType"
        },
        "objection": {
          "$ref": "#/definitions/requestType"
        },
        "withdraw": {
          "$ref": "#/definitions/requestType"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "description": "Official texts / regulator pages that every article number and deadline in this file was checked against"
    },
    "status": {
      "type": "string",
      "enum": [
        "official",
        "needs-review",
        "generic"
      ],
      "description": "official = every cite/deadline checked against an official source listed in `sources`; needs-review = partially verified; generic = no specific law, general-purpose letter"
    },
    "checkedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "notes": {
      "type": "string",
      "description": "Caveats for users, e.g. law recently amended, rights limited to citizens, fee allowed"
    }
  },
  "definitions": {
    "requestType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cite",
        "text"
      ],
      "properties": {
        "cite": {
          "type": "object",
          "required": [
            "en"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 3
          },
          "description": "Phrase that completes \"I am exercising my rights under ___\", e.g. \"Article 15 GDPR\""
        },
        "text": {
          "type": "object",
          "required": [
            "en"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 20
          },
          "description": "First-person body of the request, formal tone, 1-3 sentences, per language"
        }
      }
    }
  }
}
